pkgname="cairo"
pkgver="1.18.2"
pkgrel="1"
arch="x86_64"
depends=("glibc")
sources=(
    "https://archive.archlinux.org/packages/c/cairo/cairo-1.18.2-1-x86_64.pkg.tar.zst"
)

build() {
    :
}

package() {
    # Descarga directa con curl -L para asegurar seguir redirecciones HTTP
    ARCHIVE_FILE="${SRC_DIR}/cairo-1.18.2-1-x86_64.pkg.tar.zst"
    if [ ! -f "$ARCHIVE_FILE" ]; then
        curl -sL "https://archive.archlinux.org/packages/c/cairo/cairo-1.18.2-1-x86_64.pkg.tar.zst" -o "$ARCHIVE_FILE"
    fi
    tar -I zstd -xf "$ARCHIVE_FILE" -C "${PKG_DIR}"
    rm -f "${PKG_DIR}/.PKGINFO" "${PKG_DIR}/.BUILDINFO" "${PKG_DIR}/.MTREE"
}
