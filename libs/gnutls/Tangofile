pkgname="gnutls"
pkgver="3.8.13-3"
pkgrel="1"
arch="x86_64"
depends=("glibc" "gmp" "libtasn1" "zlib" "nettle" "leancrypto" "libstdc++" "libgcc" "libp11-kit" "libidn2" "zstd" "libidn2.so" "libunistring" "brotli")
sources=("https://geo.mirror.pkgbuild.com/core/os/x86_64/gnutls-3.8.13-3-x86_64.pkg.tar.zst")

build() {
    echo "==> Extrayendo paquete fuente genérico..."
    for pkg in "$SRC_DIR"/*.pkg.tar.zst; do
        if [ -f "$pkg" ]; then
            tar -I zstd -xf "$pkg" -C "$PKG_DIR"
        fi
    done
    rm -rf "$PKG_DIR"/.PKGINFO "$PKG_DIR"/.BUILDINFO "$PKG_DIR"/.MTREE
}

package() {
    :
}
