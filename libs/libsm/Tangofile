pkgname="libsm"
pkgver="1.2.4"
pkgrel="1"
arch="x86_64"
depends=("glibc")
sources=(
    "https://archive.archlinux.org/packages/l/libsm/libsm-1.2.4-1-x86_64.pkg.tar.zst"
)

build() {
    :
}

package() {
    # Descarga directa con curl -L para asegurar seguir redirecciones HTTP
    ARCHIVE_FILE="${SRC_DIR}/libsm-1.2.4-1-x86_64.pkg.tar.zst"
    if [ ! -f "$ARCHIVE_FILE" ]; then
        curl -sL "https://archive.archlinux.org/packages/l/libsm/libsm-1.2.4-1-x86_64.pkg.tar.zst" -o "$ARCHIVE_FILE"
    fi
    tar -I zstd -xf "$ARCHIVE_FILE" -C "${PKG_DIR}"
    rm -f "${PKG_DIR}/.PKGINFO" "${PKG_DIR}/.BUILDINFO" "${PKG_DIR}/.MTREE"
}
