pkgname="audit"
pkgver="4.2.1-1"
pkgrel="1"
arch="x86_64"
depends=("bash" "glibc" "krb5" "libkrb5.so" "libgssapi_krb5.so" "libcap-ng" "libcap-ng.so")
sources=("https://geo.mirror.pkgbuild.com/core/os/x86_64/audit-4.2.1-1-x86_64.pkg.tar.zst")

build() {
    echo "==> Extrayendo paquete fuente genérico..."
    for pkg in "$SRC_DIR"/*.pkg.tar.zst; do
        if [ -f "$pkg" ]; then
            tar -I zstd -xf "$pkg" -C "$PKG_DIR"
        fi
    done
    rm -rf "$PKG_DIR"/.PKGINFO "$PKG_DIR"/.BUILDINFO "$PKG_DIR"/.MTREE
}

package() {
    :
}
