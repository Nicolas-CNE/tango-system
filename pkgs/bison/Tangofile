pkgname="bison"
pkgver="3.8.2"
pkgrel="8"
arch="x86_64"
depends=("glibc")
sources=("https://geo.mirror.pkgbuild.com/core/os/x86_64/bison-3.8.2-8-x86_64.pkg.tar.zst")

build() {
    echo "==> Extrayendo paquete fuente genérico..."
    for pkg in "$SRC_DIR"/*.pkg.tar.zst; do
        if [ -f "$pkg" ]; then
            tar -I zstd -xf "$pkg" -C "$PKG_DIR"
        fi
    done
    rm -rf "$PKG_DIR"/.PKGINFO "$PKG_DIR"/.BUILDINFO "$PKG_DIR"/.MTREE
}

package() {
    :
}
