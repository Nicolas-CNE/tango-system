pkgname="e2fsprogs"
pkgver="1.47.4-1"
pkgrel="1"
arch="x86_64"
depends=("sh" "util-linux-libs")
sources=("https://geo.mirror.pkgbuild.com/core/os/x86_64/e2fsprogs-1.47.4-1-x86_64.pkg.tar.zst")

build() {
    echo "==> Extrayendo paquete fuente genérico..."
    for pkg in "$SRC_DIR"/*.pkg.tar.zst; do
        if [ -f "$pkg" ]; then
            tar -I zstd -xf "$pkg" -C "$PKG_DIR"
        fi
    done
    rm -rf "$PKG_DIR"/.PKGINFO "$PKG_DIR"/.BUILDINFO "$PKG_DIR"/.MTREE
}

package() {
    :
}
