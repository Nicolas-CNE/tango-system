pkgname="emacs"
pkgver="31.1"
pkgrel="2"
arch="x86_64"
depends=(
    "acl"
    "at-spi2-core"
    "attr"
    "cairo"
    "dbus"
    "fontconfig"
    "freetype2"
    "fribidi"
    "gdk-pixbuf2"
    "glib2"
    "glibc"
    "gmp"
    "gnutls"
    "gpm"
    "gtk3"
    "harfbuzz"
    "hicolor-icon-theme"
    "icu"
    "lcms2"
    "libepoxy"
    "libgccjit"
    "giflib"
    "libice"
    "libjpeg-turbo"
    "libotf"
    "libpng"
    "librsvg"
    "libsm"
    "libtiff"
    "libwebp"
    "libx11"
    "libxcb"
    "libxcomposite"
    "libxext"
    "libxfixes"
    "libxi"
    "libxinerama"
    "libxml2"
    "libxrandr"
    "libxrender"
    "ncurses"
    "nettle"
    "pango"
    "pcre2"
    "sqlite"
    "systemd-libs"
    "tree-sitter"
    "zlib-ng"
    "zstd"
)
sources=("https://geo.mirror.pkgbuild.com/extra/os/x86_64/emacs-31.1-2-x86_64.pkg.tar.zst")

build() {
    echo "==> Extrayendo paquete fuente genérico..."
    for pkg in "$SRC_DIR"/*.pkg.tar.zst; do
        if [ -f "$pkg" ]; then
            tar -I zstd -xf "$pkg" -C "$PKG_DIR"
        fi
    done
    rm -rf "$PKG_DIR"/.PKGINFO "$PKG_DIR"/.BUILDINFO "$PKG_DIR"/.MTREE
}

package() {
    :
}
