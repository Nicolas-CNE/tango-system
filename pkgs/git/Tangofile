pkgname="git"
pkgver="2.55.0"
pkgrel="1"
arch="x86_64"
depends=("glibc" "curl" "openssl" "zlib-ng" "expat" "pcre2")
sources=("https://geo.mirror.pkgbuild.com/extra/os/x86_64/git-2.55.0-1-x86_64.pkg.tar.zst")

build() {
    echo "==> Extrayendo paquete fuente genérico..."
    for pkg in "$SRC_DIR"/*.pkg.tar.zst; do
        if [ -f "$pkg" ]; then
            tar -I zstd -xf "$pkg" -C "$PKG_DIR"
        fi
    done
    rm -rf "$PKG_DIR"/.PKGINFO "$PKG_DIR"/.BUILDINFO "$PKG_DIR"/.MTREE
}

package() {
    :
}
