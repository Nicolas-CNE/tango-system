pkgname="glib2"
pkgver="2.88.3"
pkgrel="1"
arch="x86_64"
depends=()
sources=("https://geo.mirror.pkgbuild.com/core/os/x86_64/glib2-2.88.3-1-x86_64.pkg.tar.zst")

build() {
    echo "==> Extrayendo paquete fuente genérico..."
    for pkg in "$SRC_DIR"/*.pkg.tar.zst; do
        if [ -f "$pkg" ]; then
            tar -I zstd -xf "$pkg" -C "$PKG_DIR"
        fi
    done
    rm -rf "$PKG_DIR"/.PKGINFO "$PKG_DIR"/.BUILDINFO "$PKG_DIR"/.MTREE
}

package() {
    :
}
