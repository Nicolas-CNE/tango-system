pkgname="glibc"
pkgver="2.38"
pkgrel="1"
arch="x86_64"
depends=()
sources=("https://ftp.gnu.org/gnu/glibc/glibc-2.38.tar.xz")

build() {
    tar -xf "glibc-${pkgver}.tar.xz"
    cd "glibc-${pkgver}"
    mkdir -p build && cd build

    ../configure \
        --prefix=/usr \
        --disable-profile \
        --enable-kernel=5.4.0 \
        --enable-stack-protector=strong \
        --disable-werror

    make -j$(nproc)
}

package() {
    cd "glibc-${pkgver}/build"
    make DESTDIR="${PKG_DIR}" install
}
