pkgname="gnutls"
pkgver="3.8.3"
pkgrel="1"
arch="x86_64"
depends=("glibc" "gmp" "nettle")
sources=(
    "https://archive.archlinux.org/packages/g/gnutls/gnutls-${pkgver}-1-x86_64.pkg.tar.zst"
)

build() {
    # No requiere compilación de C
    :
}

package() {
    # Extraemos el contenido dentro del directorio del paquete de Tango Linux
    tar -I zstd -xf "gnutls-${pkgver}-1-x86_64.pkg.tar.zst" -C "${PKG_DIR}"
    
    # Limpiamos basura de Arch Linux (.PKGINFO, .BUILDINFO, etc.) si existe
    rm -f "${PKG_DIR}/.PKGINFO" "${PKG_DIR}/.BUILDINFO" "${PKG_DIR}/.MTREE"
}
