pkgname="libcap"
pkgver="2.78"
pkgrel="1"
arch="x86_64"
depends=("glibc")
sources=("https://geo.mirror.pkgbuild.com/core/os/x86_64/libcap-2.78-1-x86_64.pkg.tar.zst")

build() {
    # No hay compilación necesaria ya que se descarga un binario precompilado
    :
}

package() {
    echo "==> Desempaquetando archivos en PKG_DIR..."
    for pkg in "$SRC_DIR"/*.pkg.tar.zst; do
        if [ -f "$pkg" ]; then
            tar -I zstd -xf "$pkg" -C "$PKG_DIR"
        fi
    done

    # Limpiar metadatos de Arch Linux que no deben ir en Tango
    rm -rf "$PKG_DIR"/.PKGINFO "$PKG_DIR"/.BUILDINFO "$PKG_DIR"/.MTREE
}
