pkgname="lmdb"
pkgver="0.9.35-1"
pkgrel="1"
arch="x86_64"
depends=("glibc")
sources=("https://geo.mirror.pkgbuild.com/extra/os/x86_64/lmdb-0.9.35-1-x86_64.pkg.tar.zst")

build() {
    echo "==> Extrayendo paquete fuente genérico..."
    for pkg in "$SRC_DIR"/*.pkg.tar.zst; do
        if [ -f "$pkg" ]; then
            tar -I zstd -xf "$pkg" -C "$PKG_DIR"
        fi
    done
    rm -rf "$PKG_DIR"/.PKGINFO "$PKG_DIR"/.BUILDINFO "$PKG_DIR"/.MTREE
}

package() {
    :
}
