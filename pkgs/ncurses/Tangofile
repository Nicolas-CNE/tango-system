pkgname="ncurses"
pkgver="6.4"
pkgrel="1"
arch="x86_64"
depends=("glibc")
sources=("https://ftp.gnu.org/gnu/ncurses/ncurses-6.4.tar.gz")

build() {
    tar -xf "ncurses-${pkgver}.tar.gz"
    cd "ncurses-${pkgver}"

    ./configure \
        --prefix=/usr \
        --mandir=/usr/share/man \
        --with-shared \
        --without-debug \
        --without-ada \
        --without-cxx \
        --without-cxx-binding \
        --enable-widec

    make -j$(nproc)
}

package() {
    cd "ncurses-${pkgver}"
    make DESTDIR="${PKG_DIR}" install
}
